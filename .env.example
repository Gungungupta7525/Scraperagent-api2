# --- Required ---
GROQ_API_KEY=

# --- Optional ---
# Override the primary LLM model
GROQ_MODEL=llama-3.3-70b-versatile
# Smaller model used as a last-resort fallback
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# LLM fallback if Groq errors / is rate-limited
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Search: primary backend when set (free: app.tavily.com). Falls back to DuckDuckGo when unset/failing.
TAVILY_API_KEY=

# Scraping: enable Crawl4AI (JS-heavy pages) - requires optional deps
ENABLE_CRAWL4AI=false

# API / auth
CORS_ORIGINS=*
# Optional shared API key. When set, clients must send: X-API-Key: <key>
API_KEY=

# Tuning
AGENT_TIMEOUT=90
SEARCH_TIMEOUT=10
SCRAPE_TIMEOUT=15
MAX_LLM_TURNS=8
MAX_RESULTS_PER_SOURCE=15
MAX_SCRAPES=8
